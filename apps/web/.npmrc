# The web app has its own lockfile, so it repeats the repository's rules: no
# dependency may run scripts while installing, and the Node.js version is
# checked. React Native's packages ask for React Native itself as a peer;
# the web app runs React Native Web in its place, so peers are not installed.
ignore-scripts=true
engine-strict=true
legacy-peer-deps=true
