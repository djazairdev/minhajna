{
  "name": "@minhajna/web",
  "version": "0.0.0",
  "private": true,
  "description": "Minhajna's PC web app",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.ts",
    "serve": "node scripts/serve.ts",
    "zip": "node scripts/pack.ts",
    "check-host": "node scripts/check-host.ts",
    "test": "node --test --test-force-exit \"test/*.test.ts\"",
    "typecheck": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json && node ../../node_modules/typescript/bin/tsc -p scripts/tsconfig.json && node ../../node_modules/typescript/bin/tsc -p test/tsconfig.json"
  },
  "dependencies": {
    "@react-navigation/bottom-tabs": "7.22.0",
    "@react-navigation/native": "7.5.2",
    "@react-navigation/native-stack": "7.21.1",
    "@xyflow/react": "12.12.1",
    "@zip.js/zip.js": "2.25.0",
    "@zxing/library": "0.23.0",
    "echarts": "6.1.0",
    "i18next": "26.7.2",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.13",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-web": "0.21.4"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.8"
  },
  "engines": {
    "node": ">=26.13.0"
  },
  "overrides": {
    "standard-navigation": "0.0.9"
  }
}
