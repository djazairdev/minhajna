// The demo server's host on Cloudflare (answers 544, 550, 554 and 753): one
// Worker at https://minhajna-demo.djazair.dev, in front of one container built
// from apps/server/Dockerfile, its archive in the R2 bucket minhajna-demo. It
// has no workers.dev or preview address, and its logs stay off. One instance,
// since two on one bucket path would split the archive; the cron wakes it each
// day for the 7-day sweep (worker.ts). docs/demo-host.md says how it is set up.
{
  "name": "minhajna-demo",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "minhajna-demo.djazair.dev", "custom_domain": true }],
  "observability": { "enabled": false },
  "triggers": { "crons": ["17 3 * * *"] },
  "containers": [
    {
      "class_name": "DemoServer",
      "image": "../Dockerfile",
      "image_build_context": "../../..",
      "instance_type": "standard-1",
      "max_instances": 1,
    },
  ],
  "durable_objects": { "bindings": [{ "name": "SERVER", "class_name": "DemoServer" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DemoServer"] }],
}
