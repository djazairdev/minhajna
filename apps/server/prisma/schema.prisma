// The demo server's tables (#542, answers 550 and 551): worlds, their spaces
// and the sealed batches the relay hands on, each row keyed by its world and
// erased with it. Nothing here is named: ids the devices drew, hashes, days,
// ciphertext, each world's stand-in CA key (#554), which certifies nothing
// outside its world, and the key and receipts of its stand-in receiving system
// (#590), which name no pupil, each world's observatory (#621), whose
// sendings keep no school-and-term code, the admin log, whose lines name
// nobody, and each world's problem reports, whose notes the device rid of
// pupils' names (#619). A space counts its batches, and each batch takes the
// next of that count as its place in the space, so readers page through a space
// in the order uploads committed, and learn nothing of other spaces. Each
// migration is generated from this schema with `prisma migrate diff --script`
// and committed as plain SQL.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SpaceKind {
  school
  directorate
  national
}

model World {
  id            String     @id @db.Char(5)
  sealed        String
  date          DateTime   @db.Date
  announcedDays DateTime[] @db.Date
  starterHash   String     @db.Char(64)
  passHash      String     @db.Char(64)
  erasesOn      DateTime   @db.Date
  caKey         String?
  receiverKey   String?
  spaces        Space[]
  receipts      Receipt[]
  shares        Share[]
  observatory   Observatory?
  problems      Problem[]

  @@index([erasesOn])
  @@map("world")
}

model Space {
  worldId String    @db.Char(5)
  id      String    @db.VarChar(43)
  kind    SpaceKind
  count   Int       @default(0)
  world   World     @relation(fields: [worldId], references: [id], onDelete: Cascade)
  batches Batch[]

  @@id([worldId, id])
  @@map("space")
}

model Batch {
  worldId String @db.Char(5)
  spaceId String @db.VarChar(43)
  seq     Int
  stream  String @db.VarChar(43)
  number  Int
  bytes   Bytes
  space   Space  @relation(fields: [worldId, spaceId], references: [worldId, id], onDelete: Cascade)

  @@id([worldId, spaceId, seq])
  @@unique([worldId, spaceId, stream, number])
  @@map("batch")
}

model Receipt {
  seq      Int      @id @default(autoincrement())
  worldId  String   @db.Char(5)
  id       String   @db.Char(32)
  kind     String   @db.VarChar(16)
  term     Int
  class    String   @db.VarChar(32)
  subject  String   @db.VarChar(32)
  rows     Int
  signed   DateTime @db.Date
  received DateTime @db.Date
  signer   String   @db.Char(32)
  world    World    @relation(fields: [worldId], references: [id], onDelete: Cascade)

  @@unique([worldId, id])
  @@index([worldId, seq])
  @@map("receipt")
}

model Share {
  seq     Int      @id @default(autoincrement())
  worldId String   @db.Char(5)
  day     DateTime @db.Date
  id      String   @db.Char(64)
  body    Json
  world   World    @relation(fields: [worldId], references: [id], onDelete: Cascade)

  @@unique([worldId, day, id])
  @@index([worldId, day, seq])
  @@map("share")
}

model Observatory {
  worldId  String      @id @db.Char(5)
  world    World       @relation(fields: [worldId], references: [id], onDelete: Cascade)
  sendings Sending[]
  ends     EndedTerm[]

  @@map("observatory")
}

model EndedTerm {
  worldId     String      @db.Char(5)
  year        String      @db.Char(9)
  term        Int
  formed      Boolean     @default(false)
  observatory Observatory @relation(fields: [worldId], references: [worldId], onDelete: Cascade)
  packs       TermPack[]

  @@id([worldId, year, term])
  @@map("ended_term")
}

model TermPack {
  worldId String    @db.Char(5)
  year    String    @db.Char(9)
  term    Int
  at      Int
  grade   String
  subject String
  pack    String
  release String
  figures Json      @db.Json
  ended   EndedTerm @relation(fields: [worldId, year, term], references: [worldId, year, term], onDelete: Cascade)

  @@id([worldId, year, term, at])
  @@map("term_pack")
}

model Sending {
  seq         Int         @id @default(autoincrement())
  worldId     String      @db.Char(5)
  id          String      @db.Char(32)
  token       String      @db.Char(32)
  body        Json
  observatory Observatory @relation(fields: [worldId], references: [worldId], onDelete: Cascade)

  @@unique([worldId, id])
  @@index([worldId, seq])
  @@map("sending")
}

model AdminLine {
  seq    Int      @id @default(autoincrement())
  day    DateTime @db.Date
  action String   @db.VarChar(32)
  detail Json

  @@index([day])
  @@map("admin_line")
}

model Problem {
  seq       Int      @id @default(autoincrement())
  worldId   String   @db.Char(5)
  id        String   @db.Char(32)
  part      String   @db.VarChar(16)
  note      String   @db.VarChar(1000)
  version   String   @db.VarChar(32)
  received  DateTime @db.Date
  tokenHash String   @db.Char(64)
  world     World    @relation(fields: [worldId], references: [id], onDelete: Cascade)

  @@unique([worldId, id])
  @@index([worldId, seq])
  @@index([received])
  @@map("problem")
}
