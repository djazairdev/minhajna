{
  "name": "@minhajna/server",
  "version": "0.1.0",
  "private": true,
  "description": "Minhajna's server package: in 0.7.0, the demo server that holds made-up worlds",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "tools": "npm ci --no-audit --no-fund --prefix tools/prisma",
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && npm run generate && tsc -p tsconfig.json",
    "generate": "node tools/prisma/node_modules/prisma/build/index.js generate --config tools/prisma/prisma.config.ts",
    "start": "node dist/src/main.js",
    "migrate": "node dist/src/storage/migrate.js",
    "diff": "node tools/prisma/node_modules/prisma/build/index.js migrate diff --config tools/prisma/prisma.config.ts --from-config-datasource --to-schema=prisma/schema.prisma",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"dist/test/*.test.js\""
  },
  "dependencies": {
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-node": "12.3.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.16.0",
    "typescript": "6.0.3"
  },
  "overrides": {
    "qs": "6.16.1"
  }
}
