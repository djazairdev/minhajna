{
  "name": "minhajna",
  "private": true,
  "description": "Minhajna: a free, open-source app for teachers' records",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces && node --test tools/android/*.test.js",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint --max-warnings 0 . && prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
